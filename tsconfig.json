{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* retired by the 2026-10-06 revision; nothing imports them (safe to delete) */
  "exclude": [
    "src/content/story.ts",
    "src/content/timeline.ts",
    "src/content/films.ts",
    "src/content/messages.ts",
    "src/content/reflections.ts",
    "src/content/prayer.ts",
    "src/content/finale.ts",
    "src/scenes/memory.ts",
    "src/scenes/relationship.ts",
    "src/scenes/set-pieces.ts",
    "src/scenes/endings.ts",
    "src/scenes/ride.ts"
  ]
}
